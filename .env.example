# Watch 'Em All — environment template. Copy it to .env and fill in the values:
#   cp .env.example .env
#
# This is the SINGLE source of configuration for both composes — compose.yml (a
# release: pulls images) and compose-dev.yml (development: builds) — neither
# hardcodes defaults. The kit (compose.yml + this file) lives in the repo and is
# fetched at the release tag; it is not attached to the GitHub release (deployment.md).

# Image version to run — release compose.yml only: a release tag (x.y.z) or a dev
# image (dev-<branch>). Never `latest` (INF-1). Ignored by compose-dev.yml (it builds).
WEA_VERSION=0.0.1

# PostgreSQL — the only stateful service. Use strong, unique values in production.
POSTGRES_USER=watchemall
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=watchemall

# Secret used to sign the JWTs (AUTH-R3, >=256 bit). The value below is a DEV
# placeholder so the dev stack runs out of the box — for production generate a
# real one:  openssl rand -hex 32
SECRET_KEY=dev-placeholder-change-me-0123456789abcdef

# Initial administrator, created on first boot; a password change is forced at
# first login (AUTH-R8).
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-please

# Installation timezone (entered times interpreted here; stored timestamps are UTC).
TZ=Europe/Rome
