# Watch 'Em All — environment template. Copy to .env and fill in the values.
# Part of the deploy kit: this file lives in the repo and is fetched at the
# release tag (deployment.md); it is not attached to the GitHub release.

# Image version to run: a release tag (x.y.z) or a dev image (dev-<branch>) to try
# a branch before merge. Never `latest` (INF-1). Example:
WEA_VERSION=0.0.1

# PostgreSQL — the only stateful service. Use strong, unique values.
POSTGRES_USER=watchemall
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=watchemall

# Core secret for JWT signing (AUTH-R3, >=256 bit). Generate with:
#   openssl rand -hex 32
SECRET_KEY=change-me-please

# Initial administrator, created on first boot; a password change is forced at
# first login (AUTH-R8).
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-please

# Installation timezone (entered times interpreted here; stored timestamps are UTC).
TZ=Europe/Rome
